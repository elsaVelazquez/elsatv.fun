# Environment variables - NEVER commit these!
.env
*.env

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs
*.log
sync.log

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.trigger_sync

# Throwaway QA probes (headless-browser checks, screenshot scratch scripts).
# These are written, run once, and deleted — never part of the pipeline.
_probe.js
scripts/**/_qa_*.mjs

# Local YouTube posts archive (lore corpus backup) — ~1.9 GB of images,
# intentionally kept off GitHub. See lore/YTelsaTVposts/README.md
# This also covers lore/YTelsaTVposts/export/, which is where
# archive_wayback.py writes datestamped.zip. A zip must never be committed.
lore/YTelsaTVposts/

# Editor
.vscode/

# R2 credentials for sync_r2.py (account id, keys). Never commit.
.r2.env
rclone.conf

# Scraping / ingestion scripts. NOTE: add_link.py, build_albums.py and
# FINAL_SYNC.py are already tracked, and .gitignore does NOT untrack a file
# that is already in the repo. Listing them here only stops NEW files from
# being added; taking them out of the repo needs `git rm --cached <file>`.
# Also: .github/workflows/sync-releases.yml runs FINAL_SYNC.py on a nightly
# cron, so removing it from the repo breaks that job.
collect_music_links.py